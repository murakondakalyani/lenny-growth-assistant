# ==========================================
# THE LENNY GROWTH ASSISTANT
# Example Environment Configuration
# ==========================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://lenny:lenny@postgres:5432/lenny

# LLM Provider
# Options: ollama, anthropic
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Anthropic
# Optional - never commit the real key
ANTHROPIC_API_KEY=

# Retrieval
TOP_K=5

# Artifact Security
ARTIFACT_SANITIZATION_ENABLED=true