APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://lenny:lenny@postgres:5432/lenny

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

TOP_K=8
RERANK_TOP_K=5

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

ARTIFACT_SANITIZATION_ENABLED=true
ARTIFACT_IFRAME_SANDBOX=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5174